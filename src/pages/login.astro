---
import Layout from '../layouts/Layout.astro';
let error = '';

if (Astro.locals.user) return Astro.redirect('/');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const { error: err } = await Astro.locals.supabase.auth.signInWithPassword({
    email: String(form.get('email')),
    password: String(form.get('password')),
  });
  if (err) error = 'Correo o contraseña incorrectos.';
  else return Astro.redirect('/');
}
---
<Layout title="Entrar">
  <div class="card login">
    <h1>Iniciar sesión</h1>
    {error && <div class="error">{error}</div>}
    <form method="post">
      <label>Correo</label>
      <input type="email" name="email" required />
      <label>Contraseña</label>
      <input type="password" name="password" required />
      <div class="actions"><button type="submit">Entrar</button></div>
    </form>
  </div>
</Layout>
