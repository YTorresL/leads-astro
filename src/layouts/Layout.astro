---
import '@/styles/global.css';
import { buttonVariants } from '@/components/ui/button';

const { title = 'Prospectos' } = Astro.props;
const user = Astro.locals.user;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="flex items-center justify-between border-b bg-background px-6 py-3">
      <a href="/" class="font-bold tracking-tight">📇 Prospectos</a>
      {user && (
        <nav class="flex items-center gap-2">
          <a href="/companies/new" class={buttonVariants({ size: 'sm' })}>+ Nueva empresa</a>
          <a href="/logout" class={buttonVariants({ variant: 'ghost', size: 'sm' })}>Salir</a>
        </nav>
      )}
    </header>
    <main class="mx-auto my-6 max-w-6xl px-4"><slot /></main>
  </body>
</html>

<script>
  // Confirmación para acciones destructivas: <Button data-confirm="¿Seguro?">
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('[data-confirm]');
    if (el && !confirm(el.getAttribute('data-confirm') ?? '')) e.preventDefault();
  });
</script>
