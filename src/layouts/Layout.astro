---
const { title = 'Prospectos' } = Astro.props;
const user = Astro.locals.user;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" class="brand">📇 Prospectos</a>
      {user && (
        <nav>
          <a href="/empresas/nueva" class="btn">+ Nueva empresa</a>
          <a href="/logout" class="muted">Salir</a>
        </nav>
      )}
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  :root { --bg:#f6f7f9; --card:#fff; --text:#1c2230; --muted:#6b7385; --line:#e3e6ec; --brand:#4f46e5; --danger:#dc2626; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: system-ui, sans-serif; background:var(--bg); color:var(--text); line-height:1.45; }
  header { display:flex; justify-content:space-between; align-items:center; padding:.9rem 1.5rem; background:var(--card); border-bottom:1px solid var(--line); }
  header nav { display:flex; gap:1rem; align-items:center; }
  .brand { font-weight:700; color:var(--text); text-decoration:none; }
  main { max-width:1100px; margin:1.5rem auto; padding:0 1rem; }
  a { color:var(--brand); }
  .muted { color:var(--muted); }
  .card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:1.2rem; margin-bottom:1rem; }
  h1 { margin:.2rem 0 1rem; font-size:1.5rem; } h2 { font-size:1.1rem; margin:0 0 .8rem; }
  label { display:block; font-size:.8rem; color:var(--muted); margin:.7rem 0 .2rem; }
  input, select, textarea { width:100%; padding:.5rem .6rem; border:1px solid var(--line); border-radius:6px; font:inherit; background:#fff; }
  textarea { min-height:70px; resize:vertical; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:0 1rem; }
  .btn, button { display:inline-block; background:var(--brand); color:#fff; border:0; border-radius:6px; padding:.5rem .9rem; font:inherit; cursor:pointer; text-decoration:none; }
  button.secondary { background:#e8eaf0; color:var(--text); }
  button.danger { background:var(--danger); }
  .actions { display:flex; gap:.5rem; margin-top:1rem; }
  table { width:100%; border-collapse:collapse; background:var(--card); border:1px solid var(--line); border-radius:10px; overflow:hidden; }
  th, td { text-align:left; padding:.65rem .8rem; border-bottom:1px solid var(--line); font-size:.9rem; vertical-align:top; }
  th { background:#fafbfc; color:var(--muted); font-weight:600; font-size:.8rem; }
  tr:last-child td { border-bottom:0; }
  .badge { display:inline-block; font-size:.72rem; padding:.1rem .5rem; border-radius:999px; background:#eef0ff; color:var(--brand); margin:0 .2rem .2rem 0; }
  .score { font-weight:700; }
  .filters { display:flex; gap:.6rem; margin-bottom:1rem; flex-wrap:wrap; }
  .filters input { max-width:260px; } .filters select { max-width:200px; }
  .checks { display:flex; gap:1rem; flex-wrap:wrap; margin-top:.3rem; }
  .checks label { display:flex; align-items:center; gap:.3rem; margin:0; color:var(--text); font-size:.9rem; }
  .checks input { width:auto; }
  .error { background:#fee2e2; color:#991b1b; padding:.6rem .8rem; border-radius:6px; margin-bottom:1rem; }
  .ok { background:#dcfce7; color:#166534; padding:.6rem .8rem; border-radius:6px; margin-bottom:1rem; }
  .login { max-width:360px; margin:4rem auto; }
</style>
